# Application
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Local demo seed (npm run db:seed / npm run dev) — idempotent
# Login email: test_user@example.com
# Display name: Test_user
# Password: 12345678
# Public card: /u/test-user

JWT_SECRET=change-me-in-local-env-only
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://myqrcards:myqrcards@localhost:5432/myqrcards?schema=public

# Redis (matches docker-compose.yml defaults)
REDIS_URL=redis://localhost:6379

# VK ID
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=http://localhost:3000/api/v1/auth/vkid/callback
