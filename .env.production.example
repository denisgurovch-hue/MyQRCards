# Copy to /opt/myqrcards/.env.production on the VPS (never commit real secrets).
# NEXT_PUBLIC_APP_URL and WEB_ORIGIN MUST be the same public HTTPS origin.

NODE_ENV=production

# Public origin (no trailing slash) — used for QR/vCard canonical URLs and cookies CORS
NEXT_PUBLIC_APP_URL=https://cards.example.com
NEXT_PUBLIC_API_URL=https://cards.example.com
WEB_ORIGIN=https://cards.example.com

# Server-side only (inside Docker network). Do not point this at localhost from the browser.
API_URL=http://api:3001
API_PORT=3001
WEB_PORT=3000

COOKIE_SECURE=true
JWT_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Compose injects DATABASE_URL/REDIS_URL for containers; keep these for clarity/docs
POSTGRES_USER=myqrcards
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=myqrcards

# Optional overrides (compose already sets docker DNS URLs for api service)
# DATABASE_URL=postgresql://myqrcards:replace-with-strong-db-password@postgres:5432/myqrcards?schema=public
# REDIS_URL=redis://redis:6379
# Card photos: compose sets CARD_PHOTO_STORAGE_DIR=/var/lib/myqrcards/card-photos + named volume


# VK ID (optional). Redirect must match the public HTTPS origin.
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
VK_ID_REDIRECT_URI=https://cards.example.com/api/v1/auth/vkid/callback

# Deploy helpers (used by scripts, not by app containers)
# DEPLOY_HOST=deploy@vps.example.com
# DEPLOY_PATH=/opt/myqrcards
# DOMAIN=cards.example.com
